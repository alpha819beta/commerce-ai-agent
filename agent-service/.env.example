# Port this agent service listens on
PORT=3001

# Base URL of the mock e-commerce Backend API (the root project's server.ts)
API_BASE_URL=http://localhost:3000/api

# Origin allowed to call this service's /chat endpoint (the admin UI)
ADMIN_ORIGIN=http://localhost:3000

# Ollama's OpenAI-compatible endpoint and the Qwen3 model tag to use (<= 30b params)
# Pull it first with: ollama pull qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b
